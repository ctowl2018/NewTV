<resources>

    <dimen name="playback_dialog_inset">24dp</dimen>
    <dimen name="playback_dialog_spacing">8dp</dimen>
    <dimen name="playback_dialog_switch_width">47dp</dimen>
    <dimen name="playback_dialog_tab_content_spacing">16dp</dimen>

    <integer name="mpv_script_action_spacing">16</integer>
    <integer name="mpv_script_item_spacing">16</integer>

    <style name="Theme.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowAnimationStyle">@style/NoAnim</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenBackground">@color/startup_background</item>
        <!-- 系统启动槽位是方形，放不下横向组合标，这里用透明块隐藏，组合标由 HomeActivity 的闪屏层绘制 -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="android:windowBackground">@drawable/startup_window_background</item>
    </style>

    <!-- 顶部工具栏图标（搜索/收藏/连接/设置）：常态完全无背景，仅聚焦时出现半透明白色圆块 -->
    <style name="HomeToolbarIcon">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:background">@drawable/selector_toolbar_icon</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:padding">7dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/white</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowBackground">@color/grey_800</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="NoAnim">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="Shadow">
        <item name="android:shadowColor">#B0000000</item>
        <item name="android:shadowDx">1.5</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:nextFocusUp">@id/exo_progress</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Control.Script" parent="Control">
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/selector_sheet_chip</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!--
      控制条图标槽位：固定 50x40dp，左右各 3dp 外边距 → 相邻按钮间距恒为 6dp。
      槽位等宽等高，图标居中，整行视觉节奏一致；按下键不移动焦点（见 VideoActivity 的焦点绑定）。
    -->
    <style name="ControlSlot">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">center</item>
        <item name="android:nextFocusUp">@id/exo_progress</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 图标槽位：24dp 图标按 8dp 内边距居中，白/70% 白由 tint 选择器控制 -->
    <style name="ControlIconSlot" parent="ControlSlot">
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/selector_control_icon_tint</item>
    </style>

    <!-- 播放/暂停槽位：比常规按钮大一号（60x48dp，图标 40dp），聚焦高亮与其它按钮一致 -->
    <style name="ControlPlaySlot">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">center</item>
        <item name="android:nextFocusUp">@id/exo_progress</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- 纯文字槽位（片头/片尾）：最小 58dp，容得下「片头」与「00:00」两种文案 -->
    <style name="ControlTextSlot" parent="ControlSlot">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minWidth">58dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 控制条分组竖线：…… │ 片头 片尾（不可聚焦，纯视觉分隔） -->
    <style name="ControlDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:background">#33FFFFFF</item>
        <item name="android:focusable">false</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- 「播放设置」浮层面板按钮 -->
    <style name="ControlPanelChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/selector_sheet_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ControlPanelTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/white_70</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PlaybackDialogHeader">
        <item name="android:paddingStart">@dimen/playback_dialog_inset</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingEnd">@dimen/playback_dialog_inset</item>
        <item name="android:paddingBottom">@dimen/playback_dialog_spacing</item>
    </style>

    <style name="PlaybackDialogTitle">
        <item name="android:textAppearance">?attr/textAppearanceHeadlineSmall</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="PlaybackDialogAction" parent="Widget.Material3.Button.TonalButton">
        <item name="strokeColor">@color/selector_playback_dialog_action</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="PlaybackDialogTabs">
        <item name="android:layout_marginStart">@dimen/playback_dialog_inset</item>
        <item name="android:layout_marginEnd">@dimen/playback_dialog_inset</item>
        <item name="android:layout_marginBottom">@dimen/playback_dialog_spacing</item>
        <item name="selectionRequired">true</item>
        <item name="singleSelection">true</item>
    </style>

    <style name="PlaybackDialogTab" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/selector_playback_dialog_tab</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="PlaybackDialogSwitch">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:scaleX">0.75</item>
        <item name="android:scaleY">0.75</item>
    </style>

    <style name="PlaybackDialogSwitchContainer">
        <item name="android:layout_width">@dimen/playback_dialog_switch_width</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:addStatesFromChildren">true</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:foreground">@drawable/selector_playback_dialog_switch</item>
    </style>

    <style name="PlaybackDialogFirstRow">
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/playback_dialog_inset</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">@dimen/playback_dialog_inset</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="PlaybackDialogTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox" />

    <style name="PlaybackDialogBody">
        <item name="android:paddingBottom">@dimen/playback_dialog_inset</item>
    </style>

    <style name="PlaybackContentAction" parent="PlaybackDialogAction" />

    <style name="PlaybackContentCurrentAction" parent="PlaybackContentAction">
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:textColor">@color/selector_content_current</item>
    </style>

    <style name="PlaybackContentTab" parent="PlaybackDialogTab" />

    <style name="PlaybackContentItem">
        <item name="android:background">@drawable/selector_chip_round</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>

    <style name="PlaybackContentText">
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="MpvScriptItem">
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>

</resources>

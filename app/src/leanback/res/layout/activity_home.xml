<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!--
      首页右上角背景图：图片资源为 1920x1080（1280x720 的 150%，16:9），
      右上角与屏幕边缘精确贴合，左侧与底部由 FeatheredImageView 在运行时做 alpha 羽化，
      自然融入 @color/background。位于内容最底层且不参与焦点。
      实际宽高在 HomeActivity 中按屏宽比例设置（等比缩放，不变形）。
    -->
    <com.fongmi.android.NewTV.ui.custom.FeatheredImageView
        android:id="@+id/homeHero"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="top|right"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:importantForAccessibility="no" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/header"
            layout="@layout/view_home_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!--
          内容区：第 0 页是首页本体（历史 + 推荐），第 1..N 页是各分类。
          类型栏焦点横向移动到某个分类即切换过去，与分类页保持同一套交互。
        -->
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.fongmi.android.NewTV.ui.custom.ProgressLayout
                android:id="@+id/progressLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.leanback.widget.VerticalGridView
                    android:id="@+id/recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="24dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="24dp"
                    tools:visibility="visible" />

            </com.fongmi.android.NewTV.ui.custom.ProgressLayout>

            <com.fongmi.android.NewTV.ui.custom.CustomViewPager
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!--
      启动欢迎页：整幅与 App 背景同色（@color/background = #141414），
      居中的「图标 + 字标 + 标语」组合标透明淡入；
      显示时长不写死，由 HomeActivity 在首页内容加载完成后淡出。
    -->
    <FrameLayout
        android:id="@+id/splashLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:clickable="true"
        android:focusable="false">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/splashLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_logo" />

    </FrameLayout>

</FrameLayout>

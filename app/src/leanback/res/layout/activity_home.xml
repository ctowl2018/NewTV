<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!--
      ===== 首页三层结构（自下而上，绘制顺序即下面的书写顺序）=====

      L0 背景层  homeHero：右上角海报背景图（1920x1080 / 16:9）
         · 位置：父容器右上贴边（top|right），top = 0、right = 屏宽
         · 尺寸：宽 = 屏宽 × 74.4%，高按原图比例换算（HomeActivity.HERO_WIDTH_RATIO）
         · 左侧与底部由 FeatheredImageView 运行时做 alpha 羽化，融入 @color/background
      L1 标志层  homeLogo：当前海报对应的片名 logo（w500 PNG，透明底）
         · 位置：右边缘 = 背景图左边缘 + 300px（跨过左侧羽化带）；
           垂直中心 = 「导航条底边 ↔ 首张海报上方的区块标题顶边」这段留白区的正中
         · 尺寸：306×119dp 基准，左边缘若溢出屏幕则等比缩小（不裁切、不变形）
      L2 内容层  LinearLayoutCompat（页头 + 海报列表 + 分类分页）
         · 永远绘制在 L0 / L1 之上：海报、文字、焦点放大都不会被背景或 logo 压住

      L0 / L1 只作顶部装饰：它们不参与焦点、不接收点击。
      「最近观看」板块已改为贴屏幕底部对齐（见下方 recycler），海报卡片底边与屏幕底边
      之间固定留白 60px 物理像素；这段留白落在 recycler 内部（paddingBottom），
      兼作焦点放大的安全区，放大后的海报始终不超出容器边界与屏幕。
      列表不再有顶部留白带，因此背景图与 logo 常驻、不再随滚动淡出；
      logo 的垂直中心由 HomeActivity.applyLogoPlacement() 按「导航栏底边 ↔ 板块顶边」实时居中。
    -->
    <com.fongmi.android.NewTV.ui.custom.FeatheredImageView
        android:id="@+id/homeHero"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="top|right"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:importantForAccessibility="no" />

    <!--
      L1 标志层：当前海报对应的 TMDB 片名 logo（w500 PNG，透明底）。
      始终位于 L0 背景图之上、L2 内容层之下 —— 位置与层级见文件顶部说明。
      换图走 HeroFade 与背景图同一时长交叉淡入；随列表上翻由 HomeActivity 统一淡出。
    -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/homeLogo"
        android:layout_width="306dp"
        android:layout_height="119dp"
        android:layout_gravity="top|left"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <!-- L2 内容层：页头 + 内容区，永远绘制在 L0 / L1 之上。 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/header"
            layout="@layout/view_home_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!--
          内容区：胶囊 0 = 最近观看（下方 progressLayout / recycler），
          胶囊 1..N = 内嵌分页（分页 0 为「首页」，其后为各分类）。
          类型栏焦点横向移动到某个胶囊即切换过去，与分类页保持同一套交互。
        -->
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.fongmi.android.NewTV.ui.custom.ProgressLayout
                android:id="@+id/progressLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!--
                  「最近观看」网格：整块沿屏幕底部对齐，高度只由「标题行 + 一行历史海报」
                  决定，多余空间留在上方交给背景图与片名 logo 展示。

                  注意：Leanback 的 VerticalGridView 在 RelativeLayout 里以 AT_MOST 测量时
                  会把 wrap_content 撑成父容器全高（alignParentBottom / marginBottom 随之失效），
                  因此运行时的实际 height 由 HomeActivity.applyRecentBottomLayout() 按已布局
                  子项的最大 bottom 实测写入；这里 wrap_content 只是首帧兜底。

                  底部留白固定 60px（物理像素，与 HomeActivity.RECENT_BOTTOM_GAP_PX 一致），
                  刻意用 px 而非 dp：这是「海报卡片底边 ↔ 屏幕底边」的绝对间距，各端一致。

                  留白放在容器内部（paddingBottom）而不是 layout_marginBottom：
                  recycler 底边贴屏幕底（margin=0），高度 = 内容高 + 60px，
                  卡片底边自然距屏幕底 60px。选中的海报按 FocusHighlight 放大后
                  会画进这 60px padding，仍完全落在 recycler 边界内，不会被裁切或超出屏幕。
                  行容器 / HorizontalGridView 的 clipChildren 由 HomeActivity.disableClipping()
                  在运行时统一关闭，放大边角不会再被切掉。

                  不再使用旧的「顶部留白带」占位项：那套做法是把板块从顶部往下推，
                  与「底部对齐」正好相反。
                -->
                <androidx.leanback.widget.VerticalGridView
                    android:id="@+id/recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="0px"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="24dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="60px"
                    tools:visibility="visible" />

            </com.fongmi.android.NewTV.ui.custom.ProgressLayout>

            <com.fongmi.android.NewTV.ui.custom.CustomViewPager
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!--
      启动欢迎页：整幅与 App 背景同色（@color/background = #141414），
      居中的「图标 + 字标 + 标语」组合标透明淡入；
      显示时长不写死，由 HomeActivity 在首页内容加载完成后淡出。
    -->
    <FrameLayout
        android:id="@+id/splashLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:clickable="true"
        android:focusable="false">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/splashLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_logo" />

    </FrameLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  「播放设置」浮层的内容：控制条上不再直接展示的按钮。

  解码 / 画面比例 / 视轨 / 版本 / 章节 / 主菜单 / 解析 + 脚本命令按钮。
  刷新、重播、循环、播放器引擎已按要求移除，不在此面板内。

  面板本身不实现播放逻辑：每个入口只转发到控制条 hidden 容器里同名按钮的 performClick()，
  因此对话框、状态同步、错误提示全部沿用原有实现。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/sheetRow1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/panelDecoder"
            style="@style/ControlPanelChip"
            android:nextFocusDown="@id/panelChapter"
            android:nextFocusLeft="@id/panelDecoder"
            android:nextFocusRight="@id/panelScale"
            android:nextFocusUp="@id/panelDecoder"
            android:text="@string/decoder_action" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/panelScale"
            style="@style/ControlPanelChip"
            android:minWidth="148dp"
            android:nextFocusDown="@id/panelDiscMenu"
            android:nextFocusLeft="@id/panelDecoder"
            android:nextFocusRight="@id/panelVideo"
            android:nextFocusUp="@id/panelScale"
            android:text="@string/play_scale" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/panelVideo"
            style="@style/ControlPanelChip"
            android:nextFocusDown="@id/panelParse"
            android:nextFocusLeft="@id/panelScale"
            android:nextFocusRight="@id/panelEdition"
            android:nextFocusUp="@id/panelVideo"
            android:text="@string/play_track_video" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/panelEdition"
            style="@style/ControlPanelChip"
            android:layout_marginEnd="0dp"
            android:nextFocusDown="@id/panelParse"
            android:nextFocusLeft="@id/panelVideo"
            android:nextFocusRight="@id/panelEdition"
            android:nextFocusUp="@id/panelEdition"
            android:text="@string/play_edition" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/sheetRow2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/panelChapter"
            style="@style/ControlPanelChip"
            android:nextFocusDown="@id/panelChapter"
            android:nextFocusLeft="@id/panelChapter"
            android:nextFocusRight="@id/panelDiscMenu"
            android:nextFocusUp="@id/panelDecoder"
            android:text="@string/play_chapter" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/panelDiscMenu"
            style="@style/ControlPanelChip"
            android:nextFocusDown="@id/panelDiscMenu"
            android:nextFocusLeft="@id/panelChapter"
            android:nextFocusRight="@id/panelParse"
            android:nextFocusUp="@id/panelScale"
            android:text="@string/play_disc_menu" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/panelParse"
            style="@style/ControlPanelChip"
            android:layout_marginEnd="0dp"
            android:nextFocusDown="@id/panelParse"
            android:nextFocusLeft="@id/panelDiscMenu"
            android:nextFocusRight="@id/panelParse"
            android:nextFocusUp="@id/panelVideo"
            android:text="@string/parse" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- 脚本 / 命令按钮（MPV 脚本、EXO 命令）：没有可用按钮时自身 GONE，不占位 -->
    <com.fongmi.android.NewTV.ui.custom.PlaybackButtonsView
        android:id="@+id/panelScripts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:nextFocusLeft="@id/panelParse"
        android:nextFocusRight="@id/panelParse"
        tools:ignore="MissingClass" />

</androidx.appcompat.widget.LinearLayoutCompat>

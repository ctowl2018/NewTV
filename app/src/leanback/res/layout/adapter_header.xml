<?xml version="1.0" encoding="utf-8"?>
<!--
  首页「最近观看 / 首页」区块标题：18sp、中性灰 #A5A5A5（见 @color/home_section），
  避免与白色的海报标题抢注意力。

  paddingBottom = 2dp：标题与下方海报之间多加 2dp 留白。
  该布局只被 HeaderPresenter 使用，而 HeaderPresenter 只挂在首页这两行上，
  因此两处间距天然一致，其它行与页面元素不受影响。
-->
<com.google.android.material.textview.MaterialTextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:paddingBottom="2dp"
    android:textColor="@color/home_section"
    android:textSize="18sp"
    tools:text="@string/home_recommend" />

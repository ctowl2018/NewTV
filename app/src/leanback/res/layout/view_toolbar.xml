<?xml version="1.0" encoding="utf-8"?>
<!--
  顶部品牌行（与首页标题栏一致，但不含站点名称、不含导航栏胶囊）。
  用于搜索页 / 搜索详情页 / 收藏页：BrandLogoView + 搜索 / 收藏 / 连接 / 设置 + 时钟。
  （播放详情页已改为无页头，不引用本布局。）
  品牌组合与 view_home_header 复用同一个 BrandLogoView（站点 logo + 「影视 Videos」字标，锁定不可被站点数据改写）；
  本页头里品牌仅作静态展示，不触发站点菜单、不做慢闪焦点特效，故容器不可聚焦。

  顶部渐变遮罩：默认不启用（搜索页 / 搜索详情页），收藏页由
  ToolbarHeader.setScrimVisible(true) 把 shape_top_scrim 设为根布局背景来打开。
  用根布局 background 而不是独立 match_parent 子 View，可避免 wrap_content 页头被撑到整屏，
  同时保证遮罩高度 = 页头高度、下边界与导航栏下边界精确齐平；
  层级上背景天然位于品牌行及所有交互控件之下。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="6dp">

        <com.fongmi.android.NewTV.ui.custom.BrandLogoView
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <!-- 站点名称 / 搜索结果标题：与首页标题栏一致（位置/间距/字体/颜色）。
             默认无文本（仅作弹性间隔），搜索结果页会在此承载「搜索 xxx 的结果」标题 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/funcSearch"
            style="@style/HomeToolbarIcon"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/home_search"
            android:nextFocusRight="@id/funcKeep"
            android:src="@drawable/ic_toolbar_search" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/funcKeep"
            style="@style/HomeToolbarIcon"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/home_keep"
            android:nextFocusLeft="@id/funcSearch"
            android:nextFocusRight="@id/funcConnect"
            android:src="@drawable/ic_toolbar_star" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/funcConnect"
            style="@style/HomeToolbarIcon"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/home_push"
            android:nextFocusLeft="@id/funcKeep"
            android:nextFocusRight="@id/funcSetting"
            android:src="@drawable/ic_toolbar_cast" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/funcSetting"
            style="@style/HomeToolbarIcon"
            android:contentDescription="@string/home_setting"
            android:nextFocusLeft="@id/funcConnect"
            android:src="@drawable/ic_toolbar_setting" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-black"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/white"
            android:textSize="20sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>

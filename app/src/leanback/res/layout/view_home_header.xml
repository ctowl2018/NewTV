<?xml version="1.0" encoding="utf-8"?>
<!--
  全局顶部品牌行 + 类型导航栏。
  首页、搜索页、搜索结果页、播放详情页、收藏页、分类页共用本布局，
  保证各页面顶部结构、样式与焦点交互完全一致。

  品牌组合：[图标][字标]  右侧：搜索 / 收藏 / 连接 / 设置 四个无背景图标 + 时钟
  类型导航：首页与各分类同排，间距与胶囊样式由 TypeAdapter 决定
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="6dp">

        <!-- 站点选择区域：logo 图标 + 「影视 Videos」字标整体作为一个可聚焦容器；
             选中时不显示背景，改由 ToolbarHelper 慢闪动画提示 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@id/funcSearch"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/logoIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/app_name"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_logo" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/logoWord"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:layout_marginStart="8dp"
                android:adjustViewBounds="true"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_word" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.fongmi.android.NewTV.ui.custom.CustomTitleView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/funcSearch"
            style="@style/HomeToolbarIcon"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/home_search"
            android:nextFocusLeft="@id/logo"
            android:nextFocusRight="@id/funcKeep"
            android:src="@drawable/ic_toolbar_search" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/funcKeep"
            style="@style/HomeToolbarIcon"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/home_keep"
            android:nextFocusLeft="@id/funcSearch"
            android:nextFocusRight="@id/funcConnect"
            android:src="@drawable/ic_toolbar_star" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/funcConnect"
            style="@style/HomeToolbarIcon"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/home_push"
            android:nextFocusLeft="@id/funcKeep"
            android:nextFocusRight="@id/funcSetting"
            android:src="@drawable/ic_toolbar_cast" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/funcSetting"
            style="@style/HomeToolbarIcon"
            android:contentDescription="@string/home_setting"
            android:nextFocusLeft="@id/funcConnect"
            android:src="@drawable/ic_toolbar_setting" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-black"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/white"
            android:textSize="20sp"
            tools:text="09:20" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/typeNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingTop="2dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp"
        app:focusOutEnd="false"
        app:focusOutFront="false" />

</androidx.appcompat.widget.LinearLayoutCompat>
